# 環境変数（絶対にコミットしない）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
dist/
build/

# ログ
logs/
# jvlink_agent / umaconn_agent は import しただけでカレントに作る（テストが import するため）。
# 🔴 2本セットで書くこと。2026-09-01 まで umaconn_agent.log だけ漏れており、
#    テストを走らせた場所に追跡対象のゴミが残っていた（実際にルートで2本が追跡下にあった）。
jvlink_agent.log
umaconn_agent.log
odds_backfill.log

# ドキュメント生成物（PDF仕様書・検証レポート）
docs/sources/
docs/verification/

# キャッシュ・一時ファイル
BLOD_cache.jsonl
*.jsonl

# Windows agentデバッグ・テストスクリプト
windows-agent/debug_*.py
windows-agent/test_*.py

# Claude Code
# エージェント定義とスラッシュコマンドは「並列開発ハーネス」の本体であり、
# 全 worktree / 全セッションで共有される必要があるため追跡対象にする。
# ローカル権限設定・スキル・キャッシュは各自の環境依存なので追跡しない。
.claude/*
!.claude/agents/
!.claude/commands/
.claude/settings.local.json

# worktree をリポジトリ内に置いた場合の保険
# (推奨はリポジトリ外: ../kiseki-wt/。scripts/dev/wt.sh 参照)
.worktrees/

# データファイル（生データ・一時ファイル）
data/raw/
data/processed/
*.csv
backend/data/roi100/
backend/data/roi100/*.pkl
# モデル差し替え時のローカル退避先。git にもデプロイにも載せない
backend/data/backup/
# 検証用の予測キャッシュ（再生成可能・大きい）
backend/models/*_preds*.pkl

# Node.js
node_modules/
.next/
.pnpm-store/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Windows（エクスプローラのサムネイルキャッシュ・フォルダ設定）
# Parallels の Windows 11 から Z:\ 経由で作業ツリーを開くと生成される。
Thumbs.db
ehthumbs.db
desktop.ini

# Docker
docker-compose.override.yml

# 個人情報を含む書類（本リポジトリは PUBLIC のため追跡しない）
# 例: 副業許可申請書（氏名・押印・勤務先・契約条件・第三者の氏名を含む）
netkeirin/*.pdf

# --- keirin（2026-08-10 統合）---
# 実行時状態とモデルは VPS 上の実体を使う（git には入れない）。
# 旧 keirin リポジトリは data/picks の PDF 等を誤って追跡しており
# 履歴が 291MB まで膨らんでいた。同じことを繰り返さない。
keirin/data/
keirin/.venv/
keirin/*.log

# 平八データセットの中間生成物（再取得できるので追跡しない）
data/heihachi/raw/
scripts/heihachi/ocr
